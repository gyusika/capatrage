{
  "name": "capatrage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacity Arbitrage - 과수요 시장 탐지 및 경매 역산 파이프라인",
  "scripts": {
    "sitemap": "node --env-file-if-exists=.env src/sitemap.js",
    "crawl": "node --env-file-if-exists=.env src/crawl.js",
    "load": "node --env-file-if-exists=.env src/load.js",
    "booking": "node --env-file-if-exists=.env src/booking.js",
    "load:booking": "node --env-file-if-exists=.env src/load_booking.js",
    "compute": "node --env-file-if-exists=.env src/compute_fill.js",
    "sql": "node --env-file-if-exists=.env scripts/apply_sql.js",
    "daily": "npm run sitemap && npm run crawl && npm run load && npm run booking && npm run load:booking && npm run compute && npm run revenue && npm run settled",
    "web": "npm --prefix web run dev",
    "revenue": "node --env-file-if-exists=.env src/compute_revenue.js",
    "settled": "node --env-file-if-exists=.env src/compute_settled.js",
    "backfill": "node --env-file-if-exists=.env src/backfill.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
